# Configurar no painel do Render. Não carregar credenciais para o GitHub.
NODE_ENV=production
HOST=0.0.0.0
# Render fornece PORT automaticamente.
DATABASE_URL=postgresql://UTILIZADOR:PALAVRA_PASSE@HOST/BASE_DADOS
# false para a ligação interna do Render; configurar TLS conforme o fornecedor externo.
PGSSL=false
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=24h
CLIENT_URL=https://O-TEU-SITE.vercel.app
FRONTEND_URL=https://O-TEU-SITE.vercel.app
TRUST_PROXY_HOPS=1
LOCAL_POSTGRES_DOCKER=false
ENABLE_DEMO_LOGIN=false
ENABLE_PAYMENT_SIMULATION=false
