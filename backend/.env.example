# Servidor
PORT=5000
NODE_ENV=development

# CORS — URL do frontend (CLIENT_URL ou FRONTEND_URL, ambos aceites)
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Autenticação JWT
JWT_SECRET=YOUR_LONG_RANDOM_SECRET_KEY_MIN_32_CHARS
JWT_EXPIRES_IN=24h

# Email de recuperação (sem estas variáveis, o backend mostra um link de teste apenas em desenvolvimento)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# SMTP_FROM=

# Base de Dados
# PostgreSQL (produção): descomente e configure
# DATABASE_URL=postgresql://postgres:PASSWORD@localhost:5432/nexo_db

# SQLite (desenvolvimento local — criado automaticamente)
DATABASE_PATH=data/nexo.db

# Demo Login (apenas desenvolvimento)
ENABLE_DEMO_LOGIN=true
