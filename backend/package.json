{
  "name": "nexo-server",
  "version": "1.0.0",
  "description": "NEXO backend API and Socket.IO server with high-performance direct SQL queries",
  "main": "src/server.js",
  "scripts": {
    "start": "node --experimental-sqlite src/server.js",
    "dev": "node --experimental-sqlite --watch src/server.js",
    "migrate": "node --experimental-sqlite src/database/migrate.js",
    "seed": "node --experimental-sqlite src/database/seed.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "nexo",
    "e-learning",
    "community",
    "sql",
    "gamification"
  ],
  "author": "NEXO Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.0",
    "socket.io": "^4.8.1"
  },
  "type": "module"
}
