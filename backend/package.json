{
  "name": "nexo-server",
  "version": "1.0.0",
  "description": "NEXO: API REST com Express, PostgreSQL e Socket.IO",
  "main": "src/server.js",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/**/*.test.js",
    "migrate": "node src/database/migrate.js",
    "seed": "node src/database/seed.js",
    "backup": "node scripts/backup.js",
    "admin:create": "node scripts/create-admin.js",
    "account:promote": "node scripts/promote-admin.js",
    "lint": "eslint src scripts tests --quiet",
    "check": "npm run lint && npm test",
    "format": "prettier --write \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" eslint.config.mjs",
    "format:check": "prettier --check \"src/**/*.js\" \"scripts/**/*.js\" \"tests/**/*.js\" eslint.config.mjs",
    "restore": "node scripts/restore.js",
    "lint:fix": "eslint src scripts tests --fix",
    "production:check": "node scripts/check-production.js"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "keywords": [
    "nexo",
    "e-learning",
    "community",
    "sql",
    "gamification"
  ],
  "author": "NEXO Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "socket.io-client": "^4.8.4"
  }
}
