{
  "name": "nexo-server",
  "version": "1.0.0",
  "description": "NEXO: API de cursos, avaliações e comunidade com SQLite e Socket.IO",
  "main": "src/server.js",
  "scripts": {
    "start": "node --experimental-sqlite src/server.js",
    "dev": "node --experimental-sqlite --watch src/server.js",
    "test": "node --test tests/**/*.test.js",
    "migrate": "node --experimental-sqlite src/database/migrate.js",
    "seed": "node --experimental-sqlite src/database/seed.js",
    "backup": "node --experimental-sqlite scripts/backup.js",
    "admin:create": "node --experimental-sqlite scripts/create-admin.js",
    "lint": "node scripts/check.js",
    "check": "npm run lint && npm test"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "keywords": [
    "nexo",
    "e-learning",
    "community",
    "sql",
    "gamification"
  ],
  "author": "NEXO Team",
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.1",
    "express-rate-limit": "^8.7.0",
    "express-validator": "^7.3.2",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.13",
    "socket.io": "^4.8.1"
  },
  "type": "module",
  "devDependencies": {
    "socket.io-client": "^4.8.4"
  }
}
