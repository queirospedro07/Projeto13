# Copiar para .env.production no servidor. Nunca publicar este ficheiro preenchido.
APP_DOMAIN=nexo.example.com
CONTACT_EMAIL=privacidade@example.com
# Segredos distintos e aleatórios: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A palavra-passe PostgreSQL deve usar apenas letras e números para compor o URL.
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_ADMIN_PASSWORD=CHANGE_ME
JWT_SECRET=CHANGE_ME
JWT_EXPIRES_IN=24h
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
