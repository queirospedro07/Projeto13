PORT=5000
NODE_ENV=development
DATABASE_PATH=data/nexo.db
# Esta versão usa SQLite. Não configurar DATABASE_URL.
JWT_SECRET=
JWT_EXPIRES_IN=24h
CLIENT_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
# Só definir se existir um proxy de confiança à frente do backend.
# TRUST_PROXY_HOPS=1
ENABLE_DEMO_LOGIN=false
SEED_DEMO_DATA=false
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
