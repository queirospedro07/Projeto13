# ============================================================
# NEXO - Variáveis de Ambiente (exemplo)
# Copie este ficheiro para .env e preencha os valores reais
# ============================================================

# ---- Backend ------------------------------------------------
PORT=5000
NODE_ENV=development

# Base de dados PostgreSQL (produção/desenvolvimento)
DATABASE_URL=postgresql://postgres:password@localhost:5432/nexo

# Base de dados SQLite (fallback automático se PostgreSQL não disponível)
# DATABASE_PATH=./data/nexo.db

# JWT
JWT_SECRET=chave_secreta_alterar_em_producao_minimo_32_caracteres
JWT_EXPIRES_IN=24h

# CORS — URL(s) do frontend separados por vírgula
CLIENT_URL=http://localhost:5173

# Demo Login (apenas desenvolvimento)
ENABLE_DEMO_LOGIN=true

# ---- Frontend (Vite) ----------------------------------------
VITE_API_URL=http://localhost:5000/api
