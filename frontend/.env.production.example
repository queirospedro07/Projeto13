# ==========================================
# Client Production Environment Variables
# ==========================================
# Configure these variables in your Vercel Project Settings:
# Settings -> Environment Variables

# URL of your Render backend API (do NOT include a trailing slash)
VITE_API_URL=https://learnspace-backend.onrender.com

# URL for WebSockets / Socket.IO server (usually identical to VITE_API_URL)
VITE_SOCKET_URL=https://learnspace-backend.onrender.com
