# Opcional no desenvolvimento: o proxy do Vite já encaminha /api e /socket.io.
# Em produção configure os destinos HTTPS antes do build.
# VITE_API_URL=https://api.exemplo.pt/api
# VITE_SOCKET_URL=https://api.exemplo.pt
# Origem pública real: usada nos metadados, robots.txt e sitemap.xml do build.
# Sem esta variável, o build não é indexável pelos motores de pesquisa.
# VITE_SITE_URL=https://nexo.exemplo.pt
# VITE_CONTACT_EMAIL=privacidade@o-seu-dominio.pt
