{
  "name": "nexo-client",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "eslint src --quiet",
    "check": "npm run lint && npm run build",
    "format": "prettier --write \"src/**/*.{js,jsx,css}\" vite.config.js eslint.config.js",
    "format:check": "prettier --check \"src/**/*.{js,jsx,css}\" vite.config.js eslint.config.js"
  },
  "engines": {
    "node": ">=22.16.0"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "framer-motion": "^13.4.6",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.4",
    "recharts": "^2.13.3",
    "socket.io-client": "^4.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.0",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "vite": "^6.4.3"
  }
}
