# ==========================================
# Server Production Environment Variables
# ==========================================
# Configure these variables in your Render Web Service Settings:
# Settings -> Environment Variables

PORT=10000
NODE_ENV=production

# Frontend URL deployed on Vercel (used by CORS policy). Can be comma-separated if multiple.
CLIENT_URL=https://your-learnspace.vercel.app

# Cryptographically secure random JWT secret (at least 32 characters)
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=super-secret-jwt-key-change-this-to-a-random-string

# JWT expiration time
JWT_EXPIRES_IN=7d

# Path to SQLite database file
DATABASE_PATH=./data/learnspace.db
